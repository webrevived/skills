{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "coverage",
    "findings",
    "unchecked_candidates"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "clean",
        "findings",
        "incomplete"
      ],
      "description": "incomplete when unchecked_candidates is nonempty, even if findings is empty; otherwise findings for nonempty findings, or clean."
    },
    "summary": {
      "type": "string",
      "description": "Two sentences at most, describing the state of the changeset overall."
    },
    "unchecked_candidates": {
      "type": "array",
      "description": "Initial-review candidates excluded by the candidate cap or left without a verifier verdict. Always empty in verification rounds. Preserve enough detail for a separate follow-up.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "line",
          "summary",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "file": {
            "type": "string",
            "description": "Repo-relative path."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string",
            "description": "Candidate claim and concrete failure or cost scenario."
          },
          "reason": {
            "type": "string",
            "enum": [
              "candidate_cap",
              "verification_incomplete"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "file",
          "line",
          "severity",
          "category",
          "validation",
          "failure_scenario",
          "body",
          "repeat_of"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$",
            "description": "Stable short id within this round, e.g. \"F1\"."
          },
          "title": {
            "type": "string",
            "description": "One line, under 80 characters, stating the defect."
          },
          "file": {
            "type": "string",
            "description": "Repo-relative path."
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "1-indexed line the finding anchors to."
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "performance",
              "test-coverage",
              "maintainability",
              "architecture",
              "style",
              "docs"
            ]
          },
          "validation": {
            "type": "string",
            "enum": [
              "confirmed",
              "plausible"
            ]
          },
          "failure_scenario": {
            "type": "string",
            "description": "Concrete input, state, timing, platform, divergence risk, or operational cost that makes the issue material."
          },
          "body": {
            "type": "string",
            "description": "Evidence that the issue is introduced or materially worsened by the reviewed changes, why it warrants action before commit, and the required direction for the fix."
          },
          "repeat_of": {
            "type": "string",
            "description": "When re-reporting a finding from a prior round, the prior round's finding id (e.g. \"R1-F2\"). Empty string when this is new."
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Initial review: actual delegation counts. Verification rounds: all zeros.",
      "required": [
        "finders",
        "verifier_batches",
        "dedicated_verifiers",
        "candidates_assigned",
        "candidates_checked"
      ],
      "properties": {
        "finders": {
          "type": "integer",
          "minimum": 0
        },
        "verifier_batches": {
          "type": "integer",
          "minimum": 0
        },
        "dedicated_verifiers": {
          "type": "integer",
          "minimum": 0
        },
        "candidates_assigned": {
          "type": "integer",
          "minimum": 0,
          "description": "Candidates sent to verifiers."
        },
        "candidates_checked": {
          "type": "integer",
          "minimum": 0,
          "description": "Candidates that received a verifier verdict."
        }
      }
    }
  }
}
